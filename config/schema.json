{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["public_url", "agent_name", "couchdb", "caldav", "livesync", "obsidian", "telegram", "hermes"],
  "properties": {
    "public_url": {
      "type": "string",
      "pattern": "^https://[^/]+/?$",
      "description": "Public HTTPS URL clients reach the server at. No path, no port unless non-standard."
    },
    "agent_name": {
      "type": "string",
      "minLength": 1,
      "description": "Used to seed SOUL.md on first run (Hermes never overwrites once seeded)."
    },
    "couchdb": {
      "type": "object",
      "required": ["user", "password", "database"],
      "properties": {
        "user": { "type": "string", "minLength": 1 },
        "password": { "type": "string", "minLength": 1 },
        "database": { "type": "string", "minLength": 1 }
      }
    },
    "caldav": {
      "type": "object",
      "required": ["user", "password"],
      "properties": {
        "user": { "type": "string", "minLength": 1 },
        "password": { "type": "string", "minLength": 1 }
      }
    },
    "livesync": {
      "type": "object",
      "required": ["passphrase"],
      "properties": {
        "passphrase": { "type": "string", "minLength": 1 }
      }
    },
    "obsidian": {
      "type": "object",
      "required": ["vault_name"],
      "properties": {
        "vault_name": { "type": "string", "minLength": 1 }
      }
    },
    "telegram": {
      "type": "object",
      "required": ["owner_user_id", "bot_token"],
      "properties": {
        "owner_user_id": { "type": "integer" },
        "bot_token": { "type": "string", "minLength": 1 }
      }
    },
    "hermes": {
      "type": "object",
      "required": ["model"],
      "properties": {
        "model": { "type": "string", "minLength": 1 }
      }
    }
  }
}
