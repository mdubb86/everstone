{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["public_url", "name", "agent", "couchdb", "caldav", "livesync", "obsidian", "telegram", "hermes"],
  "properties": {
    "public_url": {
      "type": "string",
      "pattern": "^https://[^/]+/?$",
      "description": "Public HTTPS URL clients reach the server at. No path, no port unless non-standard."
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "description": "Owner's name. Substituted as <name> in agent.soul."
    },
    "agent": {
      "type": "object",
      "required": ["name", "soul"],
      "properties": {
        "name": { "type": "string", "minLength": 1, "description": "Agent's name. Substituted as <agent.name> in agent.soul." },
        "soul": { "type": "string", "minLength": 1, "description": "SOUL.md template. <a.b> tokens are substituted from the config tree." },
        "instructions": {
          "type": ["string", "null"],
          "description": "Optional operator-authored section appended to AGENTS.md beneath the auto-generated platform section. <a.b> tokens supported. Stays on the operator's local config.yaml — never check in."
        }
      }
    },
    "couchdb": {
      "type": "object",
      "required": ["user", "password", "database"],
      "properties": {
        "user": { "type": "string", "minLength": 1 },
        "password": { "type": "string", "minLength": 1 },
        "database": { "type": "string", "minLength": 1 }
      }
    },
    "caldav": {
      "type": "object",
      "required": ["user", "password"],
      "properties": {
        "user": { "type": "string", "minLength": 1 },
        "password": { "type": "string", "minLength": 1 }
      }
    },
    "livesync": {
      "type": "object",
      "required": ["passphrase"],
      "properties": {
        "passphrase": { "type": "string", "minLength": 1 }
      }
    },
    "obsidian": {
      "type": "object",
      "required": ["vault_name"],
      "properties": {
        "vault_name": { "type": "string", "minLength": 1 }
      }
    },
    "telegram": {
      "type": "object",
      "required": ["owner_user_id", "bot_token"],
      "properties": {
        "owner_user_id": { "type": "integer" },
        "bot_token": { "type": "string", "minLength": 1 },
        "commands": {
          "type": "array",
          "default": [],
          "description": "Slash-command autocomplete shown to users in Telegram. Default [] = no autocomplete clutter. Operator opts in.",
          "items": {
            "type": "object",
            "required": ["cmd", "desc"],
            "properties": {
              "cmd":  { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,31}$" },
              "desc": { "type": "string", "minLength": 1, "maxLength": 256 }
            }
          }
        }
      }
    },
    "hermes": {
      "type": "object",
      "required": ["model"],
      "properties": {
        "model": { "type": "string", "minLength": 1 }
      }
    }
  }
}
