#!/bin/sh
set -eu

# Generate an Obsidian LiveSync setup URI for this server.
# Based on the upstream: utils/flyio/generate_setupuri.ts in vrtmrz/obsidian-livesync.
#
# Per upstream docs (lib/src/cli/APITest.sample.ts and docs/settings.md), the
# plugin has only one passphrase setting; `usePathObfuscation: true` reuses it.

# Values injected by configure.py at container startup:
export DB_USER='{{COUCHDB_USER}}'
export DB_PASSWORD='{{COUCHDB_PASSWORD}}'
export DB_NAME='{{COUCHDB_DATABASE}}'
export LIVESYNC_PASSPHRASE='{{LIVESYNC_PASSPHRASE}}'
export COUCHDB_URI='{{PUBLIC_URL}}/db'

ts_file="/tmp/setupuri.$$.ts"
trap 'rm -f "$ts_file"' EXIT

cat > "$ts_file" <<'TYPESCRIPT_EOF'
import { encrypt } from "npm:octagonal-wheels@0.1.30/encryption/encryption";

const noun = ["waterfall","river","breeze","moon","rain","wind","sea","morning","snow","lake","sunset","pine","shadow","leaf","dawn","glitter","forest","hill","cloud","meadow","sun","glade","bird","brook","butterfly","bush","dew","dust","field","fire","flower","firefly","feather","grass","haze","mountain","night","pond","darkness","snowflake","silence","sound","sky","shape","surf","thunder","violet","water","wildflower","wave","resonance","log","dream","cherry","tree","fog","frost","voice","paper","frog","smoke","star"];
const adjectives = ["autumn","hidden","bitter","misty","silent","empty","dry","dark","summer","icy","delicate","quiet","white","cool","spring","winter","patient","twilight","dawn","crimson","wispy","weathered","blue","billowing","broken","cold","damp","falling","frosty","green","long","late","lingering","bold","little","morning","muddy","old","red","rough","still","small","sparkling","thrumming","shy","wandering","withered","wild","black","young","holy","solitary","fragrant","aged","snowy","proud","floral","restless","divine","polished","ancient","purple","lively","nameless"];

function friendlyString(): string {
    const a = adjectives[Math.floor(Math.random() * adjectives.length)];
    const n = noun[Math.floor(Math.random() * noun.length)];
    return `${a}-${n}`;
}

const URIBASE = "obsidian://setuplivesync?settings=";

async function main() {
    const couchDB_URI = Deno.env.get("COUCHDB_URI")!;
    const username    = Deno.env.get("DB_USER")!;
    const password    = Deno.env.get("DB_PASSWORD")!;
    const database    = Deno.env.get("DB_NAME")!;
    const passphrase  = Deno.env.get("LIVESYNC_PASSPHRASE")!;

    try {
        const u = new URL(couchDB_URI);
        if (!/^https?:$/.test(u.protocol)) {
            console.error("Error: base URL must be http:// or https://");
            Deno.exit(1);
        }
    } catch (_e) {
        console.error(`Error: invalid URL: ${couchDB_URI}`);
        Deno.exit(1);
    }

    const uri_passphrase = friendlyString();

    // Conf shape matches the upstream `generate_setupuri.ts` exactly.
    // Plugin has only `passphrase` as a setting; `usePathObfuscation` reuses it.
    const conf = {
        couchDB_URI,
        couchDB_USER: username,
        couchDB_PASSWORD: password,
        couchDB_DBNAME: database,
        syncOnStart: true,
        gcDelay: 0,
        periodicReplication: true,
        syncOnFileOpen: true,
        encrypt: true,
        passphrase: passphrase,
        usePathObfuscation: true,
        batchSave: true,
        batch_size: 50,
        batches_limit: 50,
        useHistory: true,
        disableRequestURI: true,
        customChunkSize: 60,                       // Config Doctor's recommended default
        usePluginSyncV2: true,                     // Per-file-saved customization sync
        chunkSplitterVersion: "v3-rabin-karp",     // V3: Fine deduplication (current best)
        syncMode: "LIVESYNC",                      // Real-time bidirectional; matches our use case
        syncAfterMerge: false,
        concurrencyOfReadChunksOnline: 100,
        minimumIntervalOfReadChunksOnline: 100,
        handleFilenameCaseSensitive: false,
        doNotUseFixedRevisionForChunks: true,
        settingVersion: 10,
        notifyThresholdOfRemoteStorageSize: 800,
    };

    const encryptedConf = encodeURIComponent(
        await encrypt(JSON.stringify(conf), uri_passphrase, false)
    );
    const theURI = `${URIBASE}${encryptedConf}`;

    const bar = "=".repeat(76);
    const sub = "-".repeat(76);
    console.log("");
    console.log(bar);
    console.log("Obsidian LiveSync onboarding — one device at a time");
    console.log(bar);
    console.log("");
    console.log("Server:  " + couchDB_URI);
    console.log("");
    console.log(sub);
    console.log("STEP 1. Install and enable the LiveSync plugin");
    console.log(sub);
    console.log("");
    console.log("  Obsidian → Settings → Community plugins → Browse →");
    console.log("    search 'Self-hosted LiveSync' → Install → Enable.");
    console.log("");
    console.log("  As soon as it's enabled, LiveSync shows a Welcome dialog.");
    console.log("  Answer:");
    console.log("");
    console.log("    Welcome to Self-hosted LiveSync");
    console.log("    \t→ I am setting this up for the first time");
    console.log("");
    console.log(sub);
    console.log("STEP 2. Paste the URI INSIDE Obsidian (not in a browser)");
    console.log(sub);
    console.log("");
    console.log("  In Obsidian, hit Cmd-P / Ctrl-P, then:");
    console.log("    'Self-hosted LiveSync: Use the copied setup URI'");
    console.log("");
    console.log("  Paste this URI when prompted:");
    console.log("");
    console.log("    " + theURI);
    console.log("");
    console.log("  Then enter this one-shot passphrase to decrypt it:");
    console.log("");
    console.log("    " + uri_passphrase);
    console.log("");
    console.log(sub);
    console.log("STEP 3. Click through the wizard");
    console.log(sub);
    console.log("");
    console.log("  LiveSync prompts a sequence of dialogs. The order may vary by");
    console.log("  plugin version, but the right answer for each title is:");
    console.log("");
    console.log("  Could not fetch configuration from remote");
    console.log("  \t→ Skip and Proceed");
    console.log("  \t  (expected on a fresh empty database — there is nothing to fetch)");
    console.log("");
    console.log("  Setup Complete: Preparing to Initialise Server");
    console.log("  \t→ Restart and Initialise Server");
    console.log("  \t  (applies the URI's settings to the empty server)");
    console.log("");
    console.log("  Final Confirmation: Overwrite Server Data with This Device's Files");
    console.log("  \t→ check ALL agreement boxes, then confirm");
    console.log("  \t  (your Mac is the authoritative source; nothing exists on the");
    console.log("  \t   server yet, so 'overwrite' is overwriting an empty DB)");
    console.log("");
    console.log("  Setting up database size notification");
    console.log("  \t→ accept the default");
    console.log("  \t  (the URI already sets a sensible 800 MB threshold)");
    console.log("");
    console.log("  Do you want to send all chunks before replication?");
    console.log("  \t→ Yes");
    console.log("  \t  (only appears in some flows; pre-uploads chunks before file");
    console.log("  \t   docs so there are no orphan-chunk states mid-sync)");
    console.log("");
    console.log("  Customisation Sync and Hidden File Sync will be disabled");
    console.log("  \t→ OK");
    console.log("  \t  (informational; leave both off unless you specifically want");
    console.log("  \t   themes/snippets or `.obsidian/` workspace state to sync)");
    console.log("");
    console.log(sub);
    console.log("STEP 4. Switch sync mode to LiveSync (real-time)");
    console.log(sub);
    console.log("");
    console.log("  Settings → Self-hosted LiveSync → Sync Settings →");
    console.log("    Presets → LiveSync → Apply");
    console.log("");
    console.log("  This is needed even though the URI sets it — the plugin");
    console.log("  initialises with 'On Events' for the wizard's safety, and");
    console.log("  the Preset > Apply step actually flips it.");
    console.log("");
    console.log("  Status bar should show ↻ briefly, then ✔ (synced).");
    console.log("");
    console.log(bar);
    console.log("");
}
await main();
TYPESCRIPT_EOF

deno run --allow-net --allow-env "$ts_file"
