#!/bin/sh
# Interactive Obsidian LiveSync onboarding walkthrough. Run inside the
# container; an interactive TTY is required.
#
# Generates a one-shot encrypted setup URI for THIS server (couchDB_URI,
# credentials, passphrase, sync settings — all baked in), then walks the
# operator through the 5 stages of LiveSync's onboarding wizard, pausing
# for Return between each stage so the operator can act in Obsidian.

set -eu

if [ ! -t 0 ] && [ ! -t 1 ]; then
    cat >&2 <<EOF
Error: setup-obsidian-livesync needs an interactive terminal.
Try:    just setup-livesync
   or:  docker exec -it everstone setup-obsidian-livesync
EOF
    exit 1
fi

# Values injected by configure.py at container startup:
export DB_USER='{{COUCHDB_USER}}'
export DB_PASSWORD='{{COUCHDB_PASSWORD}}'
export DB_NAME='{{COUCHDB_DATABASE}}'
export LIVESYNC_PASSPHRASE='{{LIVESYNC_PASSPHRASE}}'
export COUCHDB_URI='{{PUBLIC_URL}}/db'

ts_file="/tmp/setupuri.$$.ts"
trap 'rm -f "$ts_file"' EXIT

cat > "$ts_file" <<'TYPESCRIPT_EOF'
// Minimal URI generator. Prints two lines to stdout:
//   line 1: the obsidian:// setup URI
//   line 2: the one-shot decryption passphrase

import { encrypt } from "npm:octagonal-wheels@0.1.30/encryption/encryption";

const noun = ["waterfall","river","breeze","moon","rain","wind","sea","morning","snow","lake","sunset","pine","shadow","leaf","dawn","glitter","forest","hill","cloud","meadow","sun","glade","bird","brook","butterfly","bush","dew","dust","field","fire","flower","firefly","feather","grass","haze","mountain","night","pond","darkness","snowflake","silence","sound","sky","shape","surf","thunder","violet","water","wildflower","wave","resonance","log","dream","cherry","tree","fog","frost","voice","paper","frog","smoke","star"];
const adjectives = ["autumn","hidden","bitter","misty","silent","empty","dry","dark","summer","icy","delicate","quiet","white","cool","spring","winter","patient","twilight","dawn","crimson","wispy","weathered","blue","billowing","broken","cold","damp","falling","frosty","green","long","late","lingering","bold","little","morning","muddy","old","red","rough","still","small","sparkling","thrumming","shy","wandering","withered","wild","black","young","holy","solitary","fragrant","aged","snowy","proud","floral","restless","divine","polished","ancient","purple","lively","nameless"];

function friendlyString(): string {
    const a = adjectives[Math.floor(Math.random() * adjectives.length)];
    const n = noun[Math.floor(Math.random() * noun.length)];
    return `${a}-${n}`;
}

const URIBASE = "obsidian://setuplivesync?settings=";

async function main() {
    const couchDB_URI = Deno.env.get("COUCHDB_URI")!;
    const username    = Deno.env.get("DB_USER")!;
    const password    = Deno.env.get("DB_PASSWORD")!;
    const database    = Deno.env.get("DB_NAME")!;
    const passphrase  = Deno.env.get("LIVESYNC_PASSPHRASE")!;

    try {
        const u = new URL(couchDB_URI);
        if (!/^https?:$/.test(u.protocol)) throw new Error("not http/https");
    } catch (_e) {
        console.error(`Error: invalid URL: ${couchDB_URI}`);
        Deno.exit(1);
    }

    const uri_passphrase = friendlyString();

    // The chunk/E2EE *format* tweaks (customChunkSize, chunkSplitterVersion,
    // hashAlg, ...) are injected from defaults.yaml `livesync.tweaks` so every
    // device — and the bridge — share one canonical definition and can't drift.
    // The fields below are plugin *behaviour* defaults (not format), kept here.
    // readChunksOnline:false keeps every device eager/offline-capable; lower a
    // single device's syncMaxSizeInMB (or flip this) per-device for a phone that
    // shouldn't pull large attachments.
    const formatTweaks = {{LIVESYNC_TWEAKS_JSON}};
    const conf = {
        couchDB_URI,
        couchDB_USER: username,
        couchDB_PASSWORD: password,
        couchDB_DBNAME: database,
        syncOnStart: true,
        gcDelay: 0,
        periodicReplication: true,
        syncOnFileOpen: true,
        encrypt: true,
        passphrase: passphrase,
        usePathObfuscation: true,
        batchSave: true,
        batch_size: 50,
        batches_limit: 50,
        useHistory: true,
        disableRequestURI: true,
        usePluginSyncV2: true,
        syncMode: "LIVESYNC",
        syncAfterMerge: false,
        concurrencyOfReadChunksOnline: 100,
        minimumIntervalOfReadChunksOnline: 100,
        readChunksOnline: false,
        settingVersion: 10,
        notifyThresholdOfRemoteStorageSize: 800,
        ...formatTweaks,
    };

    const encryptedConf = encodeURIComponent(
        await encrypt(JSON.stringify(conf), uri_passphrase, false)
    );

    // Two-line output: URI, then passphrase. Consumed by the shell wrapper.
    console.log(`${URIBASE}${encryptedConf}`);
    console.log(uri_passphrase);
}
await main();
TYPESCRIPT_EOF

# Run the generator. Two lines come back: URI then passphrase.
gen=$(deno run --allow-net --allow-env "$ts_file")
URI=$(printf '%s\n' "$gen" | sed -n 1p)
PASSPHRASE=$(printf '%s\n' "$gen" | sed -n 2p)

bar()     { printf -- '%s\n' "============================================================================"; }
sub()     { printf -- '%s\n' "----------------------------------------------------------------------------"; }
pause()   {
    printf "\n  → Press Return to continue (Ctrl-C to abort): "
    IFS= read -r _ || true
    printf '\n'
}

bar
echo "Obsidian LiveSync onboarding — one device at a time"
bar
echo ""
echo "  Server: $COUCHDB_URI"
echo "  This walkthrough is per-device. Re-run it on each Mac/iPhone you add."
echo ""

sub
echo "STAGE 1 of 5 — Install and enable the LiveSync plugin"
sub
echo ""
echo "  Obsidian → Settings → Community plugins → Browse →"
echo "    search 'Self-hosted LiveSync' → Install → Enable."
pause

sub
echo "STAGE 2 of 5 — Welcome wizard (two quick prompts on enable)"
sub
echo ""
echo "  Welcome to Self-hosted LiveSync"
echo "      → I am setting this up for the first time"
echo ""
echo "  Connection Method"
echo "      → Use a Setup URI  (Recommended)"
pause

sub
echo "STAGE 3 of 5 — Paste the setup URI"
sub
echo ""
echo "  In Obsidian: Cmd-P / Ctrl-P →"
echo "    'Self-hosted LiveSync: Use the copied setup URI'"
echo ""
echo "  Setup URI (copy the WHOLE line):"
echo ""
echo "    $URI"
echo ""
echo "  One-shot decryption passphrase (Obsidian will prompt for this):"
echo ""
echo "    $PASSPHRASE"
echo ""
echo "  (One-shot — discarded after this device decrypts. Never asked again.)"
pause

sub
echo "STAGE 4 of 5 — Click through the remaining wizard dialogs"
sub
echo ""
echo "  Order can vary by plugin version. For each title, pick the answer below:"
echo ""
echo "  Could not fetch configuration from remote"
echo "      → Skip and Proceed"
echo "        (expected on a fresh empty database — nothing to fetch)"
echo ""
echo "  Setup Complete: Preparing to Initialise Server"
echo "      → Restart and Initialise Server"
echo "        (applies the URI's settings to the empty server)"
echo ""
echo "  Final Confirmation: Overwrite Server Data with This Device's Files"
echo "      → check ALL agreement boxes, then confirm"
echo "        (your Mac is the authoritative source; the server is empty)"
echo ""
echo "  Setting up database size notification"
echo "      → accept the default"
echo "        (URI already sets a sensible 800 MB threshold)"
echo ""
echo "  Do you want to send all chunks before replication?"
echo "      → Yes"
echo "        (avoids orphan-chunk states mid-sync; only appears in some flows)"
echo ""
echo "  Customisation Sync and Hidden File Sync will be disabled"
echo "      → OK"
echo "        (informational; enable later only if you specifically want them)"
pause

sub
echo "STAGE 5 of 5 — Apply the LiveSync sync mode preset"
sub
echo ""
echo "  Settings → Self-hosted LiveSync → Sync Settings →"
echo "    Presets → LiveSync → Apply"
echo ""
echo "  Status bar should show ↻ briefly, then ✔ (synced)."
pause

bar
echo "  Done. Onboarding complete for this device."
echo ""
echo "  Verify from any terminal:"
echo "    docker exec everstone sync-state"
bar
echo ""
