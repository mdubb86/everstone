:80 {
	handle_path /health {
		respond "OK" 200
	}

	# Build identity, baked into the image (ENV EVERSTONE_VERSION / _COMMIT) and
	# read at request time via Caddy's {env.*} placeholders — no rebuild needed
	# to reflect a different running image. Plain text/JSON, no auth (same as
	# /health). e.g. {"version":"v0.2.0","commit":"abc1234"}.
	handle_path /version {
		header Content-Type application/json
		respond `{"version":"{env.EVERSTONE_VERSION}","commit":"{env.EVERSTONE_COMMIT}"}` 200
	}

	handle_path /db/* {
		reverse_proxy localhost:5984 {
			flush_interval -1
			header_up Host {upstream_hostport}
			header_up X-Real-IP {remote_host}
			header_up X-Forwarded-For {remote_host}
			header_up X-Forwarded-Proto {scheme}
		}
	}

	# Bare /caldav (no trailing slash) -> redirect to /caldav/ so clients that omit
	# the slash still reach Radicale. 308 preserves the request method (PROPFIND,
	# REPORT, …); a 301/302 would downgrade it to GET and break CalDAV discovery.
	handle /caldav {
		redir /caldav/ 308
	}

	handle /caldav/* {
		reverse_proxy localhost:5232 {
			header_up X-Script-Name /caldav
			header_up Host {upstream_hostport}
			header_up X-Real-IP {remote_host}
			header_up X-Forwarded-For {remote_host}
			header_up X-Forwarded-Proto {scheme}
		}
	}

	# Google OAuth callback for `everstone auth gcal`. Forwarded to the
	# one-shot HTTP server /scripts/auth_gcal.py spins up on port 8081
	# while the auth flow is running. Outside the auth window, this
	# proxies to nothing and 502s — fine, no legitimate traffic ever
	# hits this path except Google's redirect after consent.
	handle /oauth/google/callback {
		reverse_proxy localhost:8081
	}

	# Web UI (hermes-webui) is mounted under /hermes/ — NOT the root — so its PWA
	# service worker is scoped to /hermes/ and cannot intercept root-level browser
	# navigations like the OAuth callback (/oauth/google/callback above). handle_path
	# strips the /hermes prefix so the upstream server (which has no base-path /
	# X-Forwarded-Prefix support) keeps operating at root; the browser keeps /hermes/
	# in the address bar, so the UI's dynamic <base href> resolves all its relative
	# assets, fetches, manifest, and SW registration under /hermes/. When the web UI
	# is disabled (no webui.password) or still starting, the proxy 502s and
	# handle_errors turns it into the friendly "web UI not enabled" page.
	handle_path /hermes/* {
		reverse_proxy localhost:8787
	}

	# Authenticated-browser login seeding (noVNC). This path is ALWAYS owned so an idle or
	# expired link never falls through to the Hermes UI below (which would look like a broken
	# auth prompt). Base state is this static "not active" page; es_login (es/es/web_login.py)
	# swaps the whole block to `reverse_proxy 127.0.0.1:6080` (websockify/noVNC) while a login
	# window is open, then swaps it back on close/timeout. Keep this block in sync with
	# _CLOSED_BLOCK in web_login.py (the runtime swap matches it by the handle_path matcher).
	handle_path /web-login/* {
		header Content-Type "text/html; charset=utf-8"
		respond `<!doctype html><meta charset=utf-8><meta name=viewport content='width=device-width,initial-scale=1'><title>Login window closed</title><body style='font-family:system-ui,sans-serif;max-width:34rem;margin:14vh auto;padding:0 1.5rem;text-align:center;color:#1c1c1e'><h1 style='font-size:1.35rem;margin-bottom:.4rem'>Login window isn't active</h1><p style='color:#555;line-height:1.55'>There's no sign-in in progress right now. Ask your assistant to start the login again, then open the fresh link it sends you.</p></body>` 200
	}

	# Everything else (bare /, old root bookmarks, bare /hermes without the slash) →
	# send to the UI. /hermes/* is handled above, so this never loops. The `*`
	# matcher is REQUIRED: `redir /hermes/ 302` mis-parses `/hermes/` as a path
	# matcher (Location would become "302"); `redir * /hermes/ 302` redirects all.
	handle /* {
		redir * /hermes/ 302
	}

	handle_errors {
		@webui_down expression {err.status_code} == 502 || {err.status_code} == 503
		handle @webui_down {
			respond "EverStone — web UI not enabled (set webui.password in config.yaml)" 200
		}
		respond "EverStone error {err.status_code}" {err.status_code}
	}
}
