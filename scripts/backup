#!/bin/sh
set -eu
BACKUP_DIR=/opt/data/backups
mkdir -p "$BACKUP_DIR"
DATE=$(date -u +%Y-%m-%dT%H%M%SZ)
OUT="$BACKUP_DIR/everstone-$DATE.tar.gz"
tar -czf "$OUT" -C /opt/data \
    --exclude=backups \
    couchdb vault radicale hermes
ls -t "$BACKUP_DIR"/everstone-*.tar.gz | tail -n +8 | xargs rm -f 2>/dev/null || true
echo "[backup] created $OUT"
