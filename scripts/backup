#!/bin/sh
set -eu
BACKUP_DIR=/opt/data/backups
mkdir -p "$BACKUP_DIR"
DATE=$(date -u +%Y-%m-%dT%H%M%SZ)
OUT="$BACKUP_DIR/everstone-$DATE.tar.gz"
# Backing up a LIVE data dir: the gateway writes session/log files under
# hermes/ while we read, so tar can emit "file changed as we read it" and exit
# 1 — the archive is still valid. Tolerate that (exit 0/1); fail only on a
# fatal tar error (exit 2). --warning=no-file-changed quiets the benign noise.
tar -czf "$OUT" -C /opt/data \
    --warning=no-file-changed \
    --exclude=backups \
    couchdb vault radicale hermes || [ "$?" -eq 1 ]
ls -t "$BACKUP_DIR"/everstone-*.tar.gz | tail -n +8 | xargs rm -f 2>/dev/null || true
echo "[backup] created $OUT"
