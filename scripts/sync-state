#!/bin/sh
# One-screen diagnostic for the LiveSync round-trip:
#   container · CouchDB · vault folder · bridge process · recent activity

set -u

CONTAINER=${EVERSTONE_CONTAINER:-everstone}

bar() { printf -- '─── %s %s\n' "$1" "$(printf -- '─%.0s' $(seq 1 $((70 - ${#1}))))"; }

# --- container ---------------------------------------------------------
bar "container"
status=$(docker ps -a --filter "name=^${CONTAINER}$" --format '{{.Status}}' 2>/dev/null)
if [ -z "$status" ]; then
    printf '  %s  not found\n' "$CONTAINER"
    printf '  (try: just dev)\n'
    exit 0
fi
printf '  %s  %s\n' "$CONTAINER" "$status"
echo ""

# Bail if container isn't running
case "$status" in
    Up\ *) : ;;
    *) printf '  container is not running — rest of report skipped\n' ; exit 0 ;;
esac

# --- couchdb -----------------------------------------------------------
bar "couchdb /db/everstone"
docker exec "$CONTAINER" sh -c '
    CONFIG=/opt/config/livesync-bridge/config.json
    user=$(grep -m1 "\"username\"" "$CONFIG" | cut -d"\"" -f4)
    pass=$(grep -m1 "\"password\"" "$CONFIG" | cut -d"\"" -f4)
    db=$(grep -m1 "\"database\"" "$CONFIG" | cut -d"\"" -f4)
    if ! info=$(curl -fsS -u "$user:$pass" "http://localhost:5984/$db" 2>&1); then
        echo "  database $db: NOT REACHABLE — $info"
        exit 0
    fi
    docs=$(echo "$info" | grep -o "\"doc_count\":[0-9]*" | head -1 | cut -d: -f2)
    seq=$(echo "$info"  | grep -o "\"update_seq\":\"[^\"]*\"" | head -1 | cut -d"\"" -f4)
    echo "  doc_count: $docs"
    echo "  update_seq prefix: $(echo "$seq" | cut -c1-12)..."
    # breakdown by prefix
    if all=$(curl -fsS -u "$user:$pass" "http://localhost:5984/$db/_all_docs" 2>/dev/null); then
        f=$(echo "$all" | grep -o "\"id\":\"f:[^\"]*\"" | wc -l)
        h=$(echo "$all" | grep -o "\"id\":\"h:[^\"]*\"" | wc -l)
        m=$(echo "$all" | grep -o "\"id\":\"[^fh:]" | wc -l)
        echo "  breakdown: $f file docs, $h chunk docs, $m metadata"
    fi
'
echo ""

# --- vault folder ------------------------------------------------------
bar "vault /opt/data/vault"
docker exec "$CONTAINER" sh -c '
    cd /opt/data/vault 2>/dev/null || { echo "  (vault dir missing)"; exit 0; }
    n=0
    for f in *; do
        [ -e "$f" ] || continue        # nothing matched the glob → "" empty case
        [ -f "$f" ] || continue
        size=$(wc -c < "$f")
        mtime=$(date -r "$f" "+%Y-%m-%d %H:%M" 2>/dev/null)
        printf "  %6d bytes  %s  %s\n" "$size" "$mtime" "$f"
        n=$((n+1))
    done
    [ "$n" -eq 0 ] && echo "  (empty)"
'
echo ""

# --- bridge ------------------------------------------------------------
bar "bridge"
docker exec "$CONTAINER" sh -c '
    s6stat=$(s6-svstat /run/s6-rc/servicedirs/livesync-bridge 2>&1 || echo "no s6 stat")
    echo "  s6:     $s6stat"
    deno_pid=$(pgrep -f "deno run.*main\.ts" | head -1)
    if [ -n "$deno_pid" ]; then
        echo "  deno:   pid $deno_pid (alive)"
    else
        echo "  deno:   NOT RUNNING"
    fi
    awk_pid=$(pgrep -f "awk.*ChangeManager" | head -1)
    if [ -n "$awk_pid" ]; then
        echo "  awk:    pid $awk_pid (watching)"
    else
        echo "  awk:    NOT RUNNING (watchdog absent)"
    fi
'
echo ""

# --- recent activity ---------------------------------------------------
bar "recent bridge activity (last 8 lines)"
docker logs --tail 400 "$CONTAINER" 2>&1 | \
    grep -vE "couchdb@127|http\.log\.error|caddy run|hermes|whatsapp|setup_|s6-rc" | \
    grep -E "bridge|WATCH|saved|change detected|ChangeManager|FATAL|LiveSync" | \
    tail -8 | sed 's/^/  /'
echo ""

# --- recent fatals -----------------------------------------------------
bar "recent FATAL / restart events"
fatals=$(docker logs --tail 1000 "$CONTAINER" 2>&1 | grep -E "FATAL|s6-supervise.*livesync-bridge.*restart" | tail -5)
if [ -z "$fatals" ]; then
    printf '  (none in last ~1000 log lines)\n'
else
    echo "$fatals" | sed 's/^/  /'
fi
