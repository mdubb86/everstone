#!/bin/sh
set -eu
export HERMES_HOME=/opt/data/hermes
. /opt/config/hermes/env

# Ensure the `everstone` profile exists (created with --no-skills so the
# image ships clean, no bundled skill set). Once per-install: idempotent.
# All subsequent hermes commands here apply to this profile.
if ! hermes profile list 2>/dev/null | grep -qE "(^|\s)everstone(\s|$)"; then
    echo "[setup_hermes] creating 'everstone' Hermes profile (--no-skills, clean)"
    hermes profile create everstone --no-skills --no-alias \
        --description "EverStone instance — minimal, opt-in skills" \
        || echo "[setup_hermes] profile create failed (already existed in a race?)"
fi
hermes profile use everstone

# Wire GitHub auth for git: if config.yaml supplied a token, set up the
# `store` credential helper pointing at $HERMES_HOME/.git-credentials.
# After this, `git clone https://github.com/<private>/repo` (and anything
# that wraps it — `hermes skills tap`, etc.) works without prompting.
if [ -n "${GH_TOKEN:-}" ]; then
    mkdir -p "$HERMES_HOME"
    creds_file="$HERMES_HOME/.git-credentials"
    git config --global credential.helper "store --file=$creds_file"
    printf 'https://oauth2:%s@github.com\n' "$GH_TOKEN" > "$creds_file"
    chmod 600 "$creds_file"
    echo "[setup_hermes] git configured to use GH_TOKEN for github.com clones"
fi

# Note: SOUL.md is rendered + overwritten by configure.py on every container
# start from config.yaml's `agent.soul`. To customize, edit that field, not
# /opt/data/hermes/SOUL.md directly.

hermes config set model "$HERMES_MODEL"
# Derive provider from the model's slash-prefix (e.g. "openai-codex/gpt-5-codex"
# → "openai-codex"). Hermes uses `provider` to pick credentials from auth.json;
# without it, the gateway falls through to "no inference provider configured".
case "$HERMES_MODEL" in
    */*) hermes config set provider "${HERMES_MODEL%%/*}" ;;
esac
hermes config set terminal.backend local
hermes config set TELEGRAM_BOT_TOKEN "$TELEGRAM_BOT_TOKEN"
hermes config set messaging.telegram.allowed_users "$TELEGRAM_ALLOWED_USERS"
hermes config set messaging.telegram.unknown_user_action ignore
hermes config set messaging.telegram.group_trigger mentions_only
python3 /scripts/merge_hermes_mcp.py

# Register slash-command autocomplete with Telegram (setMyCommands).
# TELEGRAM_COMMANDS is a JSON array of {command, description} objects,
# already in the Bot API's expected shape. Default is "[]" — that's
# fine: passing an empty array CLEARS any previous commands so the
# bot starts with no autocomplete clutter.
curl -sS -X POST "https://api.telegram.org/bot${TELEGRAM_BOT_TOKEN}/setMyCommands" \
    -H "Content-Type: application/json" \
    -d "{\"commands\": ${TELEGRAM_COMMANDS}}" \
    --max-time 10 >/dev/null \
    && echo "[setup_hermes] Telegram slash-commands set (count: $(echo "$TELEGRAM_COMMANDS" | grep -o '"command"' | wc -l))." \
    || echo "[setup_hermes] WARN: setMyCommands call failed (network? wrong token?). Bot still functional."

# gcalcli setup — if the operator configured Google Calendar in
# config.yaml, ensure the persistent config folder exists. The OAuth
# token lands here after `everstone auth gcal`; without it gcalcli
# would default to $HOME and lose state on container rebuild. The gcal
# wrapper reads EVERSTONE_GCAL_CONFIG_FOLDER and falls back to the
# same default, so a future move just needs this env var.
if [ -n "${GCALCLI_CLIENT_SECRET:-}" ]; then
    mkdir -p /opt/data/hermes/gcalcli
    if [ -f "$GCALCLI_CLIENT_SECRET" ]; then
        echo "[setup_hermes] gcalcli configured (client_secret: $GCALCLI_CLIENT_SECRET)"
    else
        echo "[setup_hermes] WARN: gcalcli configured but client_secret file missing: $GCALCLI_CLIENT_SECRET"
    fi
fi

# Install Hermes skills the operator opted into via config.agent.skills.
# Imperative model: each name in $EVERSTONE_SKILLS gets `hermes skills
# install`'d. Idempotent — Hermes skips already-installed ones. Removing
# a name from config.yaml does NOT uninstall (intentional: preserves any
# learned state). Use `hermes skills uninstall <name>` to drop one.
if [ -n "${EVERSTONE_SKILLS:-}" ]; then
    for skill in $EVERSTONE_SKILLS; do
        if hermes skills install "$skill" 2>&1 | tail -3 | head -1 \
                | grep -qiE "installed|already|up.to.date"; then
            echo "[setup_hermes] skill ready: $skill"
        else
            echo "[setup_hermes] WARN: skill install may have failed: $skill"
        fi
    done
fi

echo "[setup_hermes] applied. Run 'just hermes-auth' once (see docs/BOOTSTRAP.md)."
