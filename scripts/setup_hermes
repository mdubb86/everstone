#!/bin/sh
set -eu
export HERMES_HOME=/opt/data/hermes

# Ensure the `everstone` profile exists (created with --no-skills so the
# image ships clean, no bundled skill set). Once per-install: idempotent.
# All subsequent hermes commands here apply to this profile.
if ! hermes profile list 2>/dev/null | grep -qE "(^|\s)everstone(\s|$)"; then
    echo "[setup_hermes] creating 'everstone' Hermes profile (--no-skills, clean)"
    hermes profile create everstone --no-skills --no-alias \
        --description "EverStone instance — minimal, opt-in skills" \
        || echo "[setup_hermes] profile create failed (already existed in a race?)"
    # Seed the curated toolset ALLOWLIST once, at creation (operator owns it after).
    # Opt-in: the agent gets ONLY these toolsets — no cronjob/todo/browser/etc. that
    # compete with `es`. `hermes config set` stores scalars (not lists), so write YAML.
    python3 - <<'PY'
import os, yaml
p = "/opt/data/hermes/profiles/everstone/config.yaml"
d = (yaml.safe_load(open(p)) if os.path.exists(p) else {}) or {}
d.setdefault("platform_toolsets", {})["telegram"] = [
    "terminal", "skills", "vision", "clarify", "web", "file", "memory",
]
with open(p, "w") as f:
    yaml.safe_dump(d, f, sort_keys=False)
print("[setup_hermes] seeded curated toolset allowlist (telegram)")
PY
fi
hermes profile use everstone

# Structural constant: the agent runs tools in-container.
hermes config set terminal.backend local

# Assert the two security-critical Telegram values from config.yaml, verifying
# against drift (loud failure). config.yaml is authoritative; the LLM model +
# provider auth are NOT managed here — set them once with `esadmin model`.
if ! python3 /scripts/assert_telegram.py; then
    echo "[setup_hermes] FATAL: Telegram security assertion failed (see above)." >&2
    exit 1
fi

# Wire GitHub auth for git: if config.yaml supplied a token, set up the
# `store` credential helper pointing at $HERMES_HOME/.git-credentials.
# After this, `git clone https://github.com/<private>/repo` (and anything
# that wraps it — `hermes skills tap`, etc.) works without prompting.
GH_TOKEN="$(config-get github.token)"
if [ -n "$GH_TOKEN" ]; then
    mkdir -p "$HERMES_HOME"
    creds_file="$HERMES_HOME/.git-credentials"
    git config --global credential.helper "store --file=$creds_file"
    printf 'https://oauth2:%s@github.com\n' "$GH_TOKEN" > "$creds_file"
    chmod 600 "$creds_file"
    echo "[setup_hermes] git configured to use GH_TOKEN for github.com clones"
fi

# Note: SOUL.md is rendered + overwritten by configure.py on every container
# start from config.yaml's `agent.soul`. To customize, edit that field, not
# /opt/data/hermes/SOUL.md directly.

python3 /scripts/merge_hermes_mcp.py

# Telegram slash-commands (setMyCommands) are set by configure.py now.

# Install Hermes skills the operator opted into via config.agent.skills.
# Imperative model: each name in $EVERSTONE_SKILLS gets `hermes skills
# install`'d. Idempotent — Hermes skips already-installed ones. Removing
# a name from config.yaml does NOT uninstall (intentional: preserves any
# learned state). Use `hermes skills uninstall <name>` to drop one.
EVERSTONE_SKILLS="$(config-get agent.skills)"
if [ -n "$EVERSTONE_SKILLS" ]; then
    for skill in $EVERSTONE_SKILLS; do
        if hermes skills install "$skill" 2>&1 | tail -3 | head -1 \
                | grep -qiE "installed|already|up.to.date"; then
            echo "[setup_hermes] skill ready: $skill"
        else
            echo "[setup_hermes] WARN: skill install may have failed: $skill"
        fi
    done
fi

echo "[setup_hermes] applied. Run 'just model <provider/model>' once (see docs/BOOTSTRAP.md)."
