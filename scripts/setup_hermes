#!/bin/sh
set -eu
export HERMES_HOME=/opt/data/hermes

# Ensure the `everstone` profile exists (created with --no-skills so the
# image ships clean, no bundled skill set). Once per-install: idempotent.
# All subsequent hermes commands here apply to this profile.
if ! hermes profile list 2>/dev/null | grep -qE "(^|\s)everstone(\s|$)"; then
    echo "[setup_hermes] creating 'everstone' Hermes profile (--no-skills, clean)"
    hermes profile create everstone --no-skills --no-alias \
        --description "EverStone instance — minimal, opt-in skills" \
        || echo "[setup_hermes] profile create failed (already existed in a race?)"
    # Seed once, at creation (operator owns these after). Two different stores,
    # because Hermes reads them from two different places:
    #  - curated toolset ALLOWLIST → profile config.yaml (opt-in: only these — no
    #    cronjob/todo/browser/etc. that compete with `es`). `hermes config set`
    #    stores scalars not lists, so write the YAML directly.
    #  - Telegram home channel = owner's DM → profile .env as TELEGRAM_HOME_CHANNEL
    #    (the env var Hermes actually checks — same key /sethome persists), so
    #    cron/cross-platform delivery has a target and Hermes doesn't nag /sethome.
    python3 - <<'PY'
import yaml, pathlib
prof = pathlib.Path("/opt/data/hermes/profiles/everstone")
cfg = prof / "config.yaml"
d = (yaml.safe_load(cfg.read_text()) if cfg.exists() else {}) or {}
# Tool surface is NOT seeded here any more — assert_toolsets.py enforces it on
# EVERY boot (see below). Seeding once at create time made it a default rather
# than an assertion: drift was never corrected, and cron was never covered at
# all, so cron-spawned agents inherited the full toolset including terminal.
# Browser = the camofox-flex (Camoufox) stealth browser, reached via the CAMOFOX_URL
# env (set at the container level). DM-only: the access_hook blocks browser_* in group
# chats. managed_persistence is FALSE: flex is deliberately login-less and ephemeral
# (profiles wiped at every start), so a stable per-profile userId would only imply a
# durability it does not have. The authenticated session lives on camofox-auth (:9378),
# which es drives via CAMOFOX_AUTH_URL — browser_* must not reach it.
d.setdefault("browser", {}).setdefault("camofox", {})["managed_persistence"] = False
cfg.write_text(yaml.safe_dump(d, sort_keys=False))
owner = str(((yaml.safe_load(open("/opt/config.yaml")) or {}).get("telegram") or {})
            .get("owner_user_id", "")).strip()
if owner:
    env = prof / ".env"
    lines = [l for l in (env.read_text().splitlines() if env.exists() else [])
             if not l.startswith("TELEGRAM_HOME_CHANNEL=")]
    lines.append(f"TELEGRAM_HOME_CHANNEL={owner}")
    env.write_text("\n".join(lines) + "\n")
print("[setup_hermes] seeded toolset allowlist (config) + home channel (.env)")
PY
fi
hermes profile use everstone

# Render SOUL.md from config.agent.soul into the profile. Done HERE — after the
# canonical `--no-skills` create above — so the profile already has its
# bundled-skill opt-out marker before anything writes into profiles/everstone/.
# configure.py deliberately no longer renders this (its earlier mkdir won the race
# against the create and left the profile bundled). Idempotent: always overwrites
# from config.yaml, the source of truth for the persona.
python3 /scripts/render_soul.py

# Structural constant: the agent runs tools in-container.
hermes config set terminal.backend local

# Assert the two security-critical Telegram values from config.yaml, verifying
# against drift (loud failure). config.yaml is authoritative; the LLM model +
# provider auth are NOT managed here — set them once with `esadmin model`.
if ! python3 /scripts/assert_telegram.py; then
    echo "[setup_hermes] FATAL: Telegram security assertion failed (see above)." >&2
    exit 1
fi

# Assert the agent's tool surface every boot: the curated allowlist per platform
# (telegram + cron) and the toolset denylist. ENFORCES rather than failing —
# a widened surface self-heals on restart instead of bricking the assistant.
python3 /scripts/assert_toolsets.py

# Wire GitHub auth for git: if config.yaml supplied a token, set up the
# `store` credential helper pointing at $HERMES_HOME/.git-credentials.
# After this, `git clone https://github.com/<private>/repo` (and anything
# that wraps it — `hermes skills tap`, etc.) works without prompting.
GH_TOKEN="$(config-get github.token)"
if [ -n "$GH_TOKEN" ]; then
    mkdir -p "$HERMES_HOME"
    creds_file="$HERMES_HOME/.git-credentials"
    git config --global credential.helper "store --file=$creds_file"
    printf 'https://oauth2:%s@github.com\n' "$GH_TOKEN" > "$creds_file"
    chmod 600 "$creds_file"
    echo "[setup_hermes] git configured to use GH_TOKEN for github.com clones"
fi

# Brave Search API key: config.yaml is authoritative (key `brave.api_key`). Wire
# it into the profile .env as BRAVE_SEARCH_API_KEY — the env var Hermes' web_tools
# backend selector checks to pick the Brave backend (else it falls back to the
# keyless ddgs backend). Runs EVERY start (not just first-create) so existing
# profiles pick up config changes; an empty/removed key clears the line.
BRAVE_ENV="/opt/data/hermes/profiles/everstone/.env"
BRAVE_KEY="$(config-get brave.api_key)"
if [ -f "$BRAVE_ENV" ]; then
    grep -v '^BRAVE_SEARCH_API_KEY=' "$BRAVE_ENV" > "$BRAVE_ENV.tmp" && mv "$BRAVE_ENV.tmp" "$BRAVE_ENV"
fi
if [ -n "$BRAVE_KEY" ]; then
    mkdir -p "$(dirname "$BRAVE_ENV")"
    printf 'BRAVE_SEARCH_API_KEY=%s\n' "$BRAVE_KEY" >> "$BRAVE_ENV"
    echo "[setup_hermes] wired BRAVE_SEARCH_API_KEY from config.brave.api_key"
else
    echo "[setup_hermes] brave.api_key unset — web_search uses keyless ddgs backend"
fi

# Note: SOUL.md is rendered + overwritten above (via render_soul.py) on every
# container start from config.yaml's `agent.soul`. To customize, edit that field,
# not the profile's SOUL.md directly.

python3 /scripts/merge_hermes_mcp.py

# Telegram slash-commands (setMyCommands) are set by configure.py now.

# Install Hermes skills the operator opted into via config.agent.skills.
# Imperative model: each name in $EVERSTONE_SKILLS gets `hermes skills
# install`'d. Idempotent — Hermes skips already-installed ones. Removing
# a name from config.yaml does NOT uninstall (intentional: preserves any
# learned state). Use `hermes skills uninstall <name>` to drop one.
EVERSTONE_SKILLS="$(config-get agent.skills)"
if [ -n "$EVERSTONE_SKILLS" ]; then
    for skill in $EVERSTONE_SKILLS; do
        if hermes skills install "$skill" 2>&1 | tail -3 | head -1 \
                | grep -qiE "installed|already|up.to.date"; then
            echo "[setup_hermes] skill ready: $skill"
        else
            echo "[setup_hermes] WARN: skill install may have failed: $skill"
        fi
    done
fi

echo "[setup_hermes] applied. Run 'just model <provider/model>' once (see docs/BOOTSTRAP.md)."
