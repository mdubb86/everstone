#!/bin/sh
# gcal — thin wrapper around gcalcli that always passes the operator's
# OAuth client_secret + a persistent --config-folder on the data volume.
# The agent uses `gcal <subcommand>` instead of raw `gcalcli` so it
# never has to know about secret paths or config locations.
#
# Reads GCALCLI_CLIENT_SECRET from /opt/config/hermes/env (set by
# configure.py from config.gcalcli.client_secret_file).
set -eu

. /opt/config/hermes/env

if [ -z "${GCALCLI_CLIENT_SECRET:-}" ]; then
    cat >&2 <<EOF
gcal: Google Calendar is not configured.

Set config.gcalcli.{client_secret_file, calendars} in config.yaml,
restart the container, then run: everstone auth gcal
EOF
    exit 1
fi

if [ ! -f "$GCALCLI_CLIENT_SECRET" ]; then
    echo "gcal: client_secret file not found: $GCALCLI_CLIENT_SECRET" >&2
    echo "       Drop the Google Cloud Console download into your data volume." >&2
    exit 1
fi

CONFIG_FOLDER="${EVERSTONE_GCAL_CONFIG_FOLDER:-/opt/data/hermes/gcalcli}"
mkdir -p "$CONFIG_FOLDER"

exec gcalcli \
    --client-secret "$GCALCLI_CLIENT_SECRET" \
    --config-folder "$CONFIG_FOLDER" \
    "$@"
